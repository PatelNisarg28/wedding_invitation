{
  "name": "nisarg-weds-devanshi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "npm run build && wrangler pages dev dist --port 8788",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b && tsc -p functions/tsconfig.json",
    "preview": "wrangler pages dev dist --port 8788",
    "db:migrate:local": "wrangler d1 migrations apply nwd-rsvp --local",
    "db:migrate:remote": "wrangler d1 migrations apply nwd-rsvp --remote",
    "deploy": "npm run build && wrangler pages deploy dist --project-name nisarg-weds-devanshi --branch main"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/mukta": "^5.3.0",
    "@fontsource/tiro-devanagari-hindi": "^5.3.0",
    "framer-motion": "^14.9.0",
    "preact": "^11.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261101.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "wrangler": "^4.156.0"
  }
}
